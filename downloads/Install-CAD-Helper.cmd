@echo off
setlocal
title Conveyor Layout Studio - Free CAD Setup
set "CAD_HELPER_SELF=%~f0"
echo Preparing free CAD helper. Please keep this window open.
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; $text=[IO.File]::ReadAllText($env:CAD_HELPER_SELF); $bytes=[Convert]::FromBase64String(($text -split ':CAD_PAYLOAD\r?\n',2)[1].Trim()); $sha=[Security.Cryptography.SHA256]::Create(); $actual=([BitConverter]::ToString($sha.ComputeHash($bytes))).Replace('-','').ToLower(); if($actual -ne '684eca39f480b5bd0f62b78443c3adf10039d6b6a4664d7ecf4bb12c416ad3ec'){throw 'Helper package checksum mismatch'}; $root=Join-Path $env:LOCALAPPDATA 'ConveyorLayoutStudio\helper-684eca39f480'; New-Item -ItemType Directory -Force -Path $root | Out-Null; $archive=Join-Path $root 'helper.zip'; [IO.File]::WriteAllBytes($archive,$bytes); Add-Type -AssemblyName System.IO.Compression.FileSystem; $z=[IO.Compression.ZipFile]::OpenRead($archive); try {foreach($entry in $z.Entries){$target=[IO.Path]::GetFullPath((Join-Path $root $entry.FullName)); if(!$target.StartsWith(([IO.Path]::GetFullPath($root)+[IO.Path]::DirectorySeparatorChar),[StringComparison]::OrdinalIgnoreCase)){throw 'Invalid archive path'}; if(!$entry.Name){[IO.Directory]::CreateDirectory($target) | Out-Null}else{[IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($target)) | Out-Null; [IO.Compression.ZipFileExtensions]::ExtractToFile($entry,$target,$true)}}}finally{$z.Dispose()}; if($env:CAD_HELPER_VERIFY_ONLY -eq '1'){Write-Host 'Package verified and extracted'; exit 0}; & (Join-Path $root 'Start-CAD-Bridge.cmd'); if($LASTEXITCODE){exit $LASTEXITCODE}"
if errorlevel 1 (
  echo Setup could not finish. Check the message above or company policy.
  echo Security settings were not changed.
  pause
  exit /b 1
)
exit /b 0
:CAD_PAYLOAD

